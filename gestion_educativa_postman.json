      "name": "Auth",
      "item": [
        {
          "name": "Register - POST /api/auth/register/",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register/", "host": ["{{baseUrl}}"], "path": ["api","auth","register",""] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@gestion.edu\",\n  \"first_name\": \"Admin\",\n  \"last_name\": \"Sistema\",\n  \"password\": \"admin123\"\n}" }
          }
        },
        {
          "name": "Login - POST /api/auth/login/ (guarda tokens)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "let d = {};",
                "try { d = pm.response.json(); } catch(e) {}",
                "if (d.access) { pm.collectionVariables.set('accessToken', d.access); pm.environment.set('accessToken', d.access); }",
                "if (d.refresh) { pm.collectionVariables.set('refreshToken', d.refresh); pm.environment.set('refreshToken', d.refresh); }",
                "pm.test('Login exitoso', () => pm.expect(d.access).to.be.a('string'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api","auth","login",""] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" }
          }
        },
        {
          "name": "Refresh - POST /api/auth/refresh/",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "let d = {};",
                "try { d = pm.response.json(); } catch(e) {}",
                "if (d.access) pm.collectionVariables.set('accessToken', d.access);",
                "pm.test('Token refrescado', () => pm.expect(d.access).to.be.a('string'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh/", "host": ["{{baseUrl}}"], "path": ["api","auth","refresh",""] },
            "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Logout - POST /api/auth/logout/",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/logout/", "host": ["{{baseUrl}}"], "path": ["api","auth","logout",""] },
            "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
